# Compose variables, not application credentials. Copy to deploy/.env locally.
NEXA_IMAGE=nexa-home:1.0.0
NEXA_HOST_BIND=127.0.0.1
NEXA_HOST_PORT=8080

# Set the exact external HTTPS origin for reverse-proxy deployments.
NEXA_PUBLIC_ORIGIN=https://home.example.com
# Trust only the actual proxy peer/network, never 0.0.0.0/0 or ::/0.
NEXA_TRUSTED_PROXY_CIDRS=
NEXA_ALLOW_HTTP_COOKIE=false
NEXA_LOG_LEVEL=info

# Isolated loopback/LAN HTTP exception only (not Internet-facing):
# NEXA_PUBLIC_ORIGIN=http://127.0.0.1:8080
# NEXA_ALLOW_HTTP_COOKIE=true
# Exposing a LAN port additionally requires an explicit NEXA_HOST_BIND change.
