# Install inside an existing NGINX http {} context. Supply your own trusted
# certificate and key, replace the hostname, and keep the backend loopback-only.
server {
    listen 443 ssl;
    server_name home.example.com;

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 16m;
    client_body_timeout 30s;
    # Do not log credentials, query strings, private URLs or request bodies.
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # This example has one edge proxy; discard untrusted incoming chains.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 310s;
        proxy_send_timeout 310s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
    }
}
