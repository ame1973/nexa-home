{
  "name": "nexa-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@nexa-home/web",
    "build:web": "npm run build --workspace=@nexa-home/web",
    "build": "npm run build:web && CGO_ENABLED=0 go build -trimpath -o bin/nexa-home ./cmd/nexa-home",
    "typecheck": "npm run typecheck --workspace=@nexa-home/web && tsc --project e2e/tsconfig.json",
    "test:build": "node --test scripts/sonner-csp.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:container": "node --test scripts/container.test.mjs",
    "scan:image": "sh scripts/scan-image.sh",
    "notices": "node scripts/notices.mjs",
    "lint:web": "npm run lint --workspace=@nexa-home/web",
    "test:web": "npm run test --workspace=@nexa-home/web",
    "generate": "node scripts/generate-contract.mjs",
    "lint:api": "redocly lint api/openapi.yaml",
    "test:contract": "node --test scripts/contract.test.mjs",
    "check:generated": "npm run generate && git diff --exit-code -- api/openapi.json apps/web/src/lib/api/schema.d.ts"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    },
    "eslint": {
      "minimatch": "11.0.4"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.73.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "undici": "7.30.1",
    "yaml": "2.9.1"
  }
}
