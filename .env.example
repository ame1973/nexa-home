# Copy to .env beside compose.yaml. These are settings, not credentials.
# This preset is ONLY for an isolated browser on the same host.
NEXA_IMAGE=ghcr.io/ame1973/nexa-home:latest
NEXA_HOST_BIND=127.0.0.1
NEXA_HOST_PORT=8080
NEXA_PUBLIC_ORIGIN=http://127.0.0.1:8080
NEXA_TRUSTED_PROXY_CIDRS=
NEXA_ALLOW_HTTP_COOKIE=true
NEXA_LOG_LEVEL=info

# Pin NEXA_IMAGE to an existing version or index digest for controlled upgrades.
# Remote access requires a trusted HTTPS reverse proxy and these replacements:
# NEXA_PUBLIC_ORIGIN=https://home.example.com
# NEXA_ALLOW_HTTP_COOKIE=false
# Keep the backend private; never expose the HTTP preset to the Internet.
